.SS Practical Example: Ship Building
.nf
const buildShip = (credits: int, game: GameState) => 
    Option<ShipDesign> {
    
    if (credits < 15) return None;
    
    // Check if we need carriers
    const carriers = game.myShips
        |> filter(s => s.systemRacks > 0)
        |> count();
    
    if (carriers < 2 && credits >= 20) {
        return Some(buildCarrier(credits));
    } else {
        return Some(buildAttacker(credits));
    }
};

const buildAttacker = (credits: int) => ShipDesign {
    const budget = credits - 5;  // Warp Generator
    
    return {
        type: WarpShip,
        name: "Attacker",
        pd: floor(budget * 0.30),
        beam: floor(budget * 0.45),
        screen: floor(budget * 0.15),
        tubes: floor(budget * 0.10),
        missiles: floor(budget * 0.10) * 3,
        systemRacks: 0
    };
};
.fi

.SS Practical Example: Combat Tactics
.nf
const selectTactic = (ship: Ship, enemies: Ship[]) => Tactic {
    const myStrength = evaluateStrength(ship);
    const enemyStrength = enemies
        |> map(evaluateStrength)
        |> sum();
    const ratio = myStrength / enemyStrength;
    
    return match (ratio, ship.isWarpShip) {
        (r, true) when r < 0.30 => Retreat,
        (r, _) when r > 1.50    => Attack,
        _                       => Dodge
    };
};

const allocatePower = (ship: Ship, tactic: Tactic, 
                       enemies: Ship[]) => PowerAllocation {
    return match (tactic) {
        Attack => {
            pd: ship.currentPD,
            beam: min(ship.beamMax, ship.currentPD / 2),
            screen: 0,
            tubes: ship.hasMissiles() ? min(2, ship.tubes) : 0,
            missiles: ship.hasMissiles() 
                ? repeat(ship.pdMax, 2) 
                : []
        },
        Dodge => {
            pd: ship.currentPD,
            beam: ship.currentPD / 3,
            screen: ship.currentPD / 3,
            tubes: 0,
            missiles: []
        },
        Retreat => {
            pd: ship.currentPD,
            beam: 0,
            screen: 0,
            tubes: 0,
            missiles: []
        }
    };
};
.fi

.SS Practical Example: SystemShip Tactics
.nf
const shouldDropSystemShip = (carrier: Ship, systemship: Ship,
                               hexId: HexID, game: GameState) => bool {
    // Garrison friendly bases
    if (game.isMyBaseHex(hexId)) return true;
    
    // Support attacks on enemy bases
    if (game.isEnemyBaseHex(hexId) && 
        game.myShipsAt(hexId).count() > 1) {
        return true;
    }
    
    // Preserve systemship if carrier retreating
    const enemies = game.enemyShipsAt(hexId);
    if (shouldRetreat(carrier, enemies)) return true;
    
    return false;
};

const shouldPickupSystemShip = (carrier: Ship, systemship: Ship,
                                 game: GameState) => bool {
    if (!carrier.hasFreeRack()) return false;
    
    // Evacuate if enemies approaching
    const threats = game.enemyShipsWithinRange(
        systemship.location, 3
    );
    
    return threats.count() > 0;
};
.fi

.SS Ring-0 Strategies
The server ships with three baseline KHS strategies in
.I /opt/kepler/ai/
demonstrating different playstyles:

.TP
.B aggressive.khs
Offensive focus: 45% beam, 30% PD, 15% screen. Attacks when ratio > 1.5, retreats only when ratio < 0.3. Rushes enemy bases early.

.TP
.B defensive.khs
Defensive focus: 20% beam, 40% screen, 30% PD. Prefers Dodge tactic, retreats at ratio < 0.5. Garrisons own bases first.

.TP
.B balanced.khs
Mixed approach: 35% beam, 30% PD, 20% screen. Adapts tactics based on local strength ratios. Builds mix of carriers and attackers.

.SS Reloading Strategy
Edit the active strategy file, then signal the server:
.nf
# Edit strategy
vim /opt/kepler/ai/strategy.khs

# Reload without restart
kill -HUP $(pidof khserver)

# Verify in logs
tail -f /var/log/kepler/server.log
# [AI] Reloading: /opt/kepler/ai/strategy.khs
# [AI] ✓ Reload successful
.fi

Changes take effect on the AI's next turn. Failed reloads keep the previous strategy active.

.SS Best Practices
.IP 1. 3
Use pattern matching for decision trees rather than nested if-else
.IP 2. 3
Prefer pure functions - same inputs always produce same outputs
.IP 3. 3
Leverage pipe operator (|>) for readable data transformations
.IP 4. 3
Keep functions focused - one decision per function
.IP 5. 3
Test strategies against each other by swapping active script
.IP 6. 3
Balance offense and defense - pure strategies are exploitable
.IP 7. 3
Remember SystemShips are force multipliers (no WG cost)

